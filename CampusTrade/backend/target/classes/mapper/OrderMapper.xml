<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campustrade.mapper.OrderMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.campustrade.entity.Order">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="buyer_id" property="buyerId"/>
        <result column="seller_id" property="sellerId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="amount" property="amount"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 分页查询买家订单 -->
    <select id="selectByBuyerId" resultMap="BaseResultMap">
        SELECT * FROM orders
        WHERE buyer_id = #{buyerId}
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- 分页查询卖家订单 -->
    <select id="selectBySellerId" resultMap="BaseResultMap">
        SELECT * FROM orders
        WHERE seller_id = #{sellerId}
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- 统计今日订单数 -->
    <select id="countToday" resultType="java.lang.Long">
        SELECT COUNT(*) FROM orders
        WHERE DATE(create_time) = CURDATE()
    </select>

    <!-- 统计今日交易额 -->
    <select id="sumTodayAmount" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(amount), 0) FROM orders
        WHERE DATE(create_time) = CURDATE()
        AND status IN (3, 5)
    </select>

    <!-- 统计总订单数 -->
    <select id="countTotal" resultType="java.lang.Long">
        SELECT COUNT(*) FROM orders
    </select>

    <!-- 统计总交易额 -->
    <select id="sumTotalAmount" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(amount), 0) FROM orders
        WHERE status IN (3, 5)
    </select>
</mapper>
