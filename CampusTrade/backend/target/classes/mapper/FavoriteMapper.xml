<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campustrade.mapper.FavoriteMapper">

    <!-- 分页查询用户的收藏商品列表 -->
    <select id="selectFavoriteGoods" resultType="com.campustrade.entity.Goods">
        SELECT g.* FROM goods g
        INNER JOIN favorite f ON g.id = f.goods_id
        WHERE f.user_id = #{userId}
        ORDER BY f.create_time DESC
    </select>

    <!-- 统计收藏数 -->
    <select id="countByGoodsId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM favorite WHERE goods_id = #{goodsId}
    </select>
</mapper>
